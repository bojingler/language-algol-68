# Editor settings for ALGOL 68 sources.
#
# Comments: the Report's comment symbols do not nest, so a toggled line must not hold the
# symbol itself.  For PA/68 and GNU Algol 68 sources the brace comment is the safer choice
# (it nests and passes over string denotations); README.md shows how to select it.
#
# Indentation: a line that opens a clause without closing it indents the next one; a line
# that begins with a word closing or continuing a clause goes back one level.
'.source.algol68':
  'editor':
    'commentStart': '# '
    'commentEnd': ' #'
    'increaseIndentPattern': '\\b(?:BEGIN|IF|THEN|ELIF|ELSE|CASE|IN|OUSE|OUT|FOR|WHILE|DO|DEF|POSTLUDE)\\b(?!.*\\b(?:END|FI|ESAC|OD|FED)\\b)|[(\\[][ \\t]*$'
    'decreaseIndentPattern': '^[ \\t]*(?:(?:END|FI|ESAC|OD|FED|THEN|ELIF|ELSE|IN|OUSE|OUT|DO|POSTLUDE)\\b|[)\\]])'
    'foldEndPattern': '^[ \\t]*(?:(?:END|FI|ESAC|OD|FED)\\b|[)\\]])'
  'bracket-matcher':
    'autocompleteCharacters': [
      '()'
      '[]'
      '{}'
      '""'
    ]
# In a source with reserved words in small letters (the grammar says so in the scope of every
# token after its decision) the same patterns hold for the small-letter words, and the comment
# is GNU Algol 68's, which is the only one that stropping has.
'.source.algol68 .meta.stropping.supper.algol68':
  'editor':
    'commentStart': '{ '
    'commentEnd': ' }'
    'increaseIndentPattern': '(?<![A-Za-z0-9_])(?:begin|if|then|elif|else|case|in|ouse|out|for|while|do|def|postlude)(?![A-Za-z0-9_])(?!.*(?<![A-Za-z0-9_])(?:end|fi|esac|od|fed)(?![A-Za-z0-9_]))|[(\\[][ \\t]*$'
    'decreaseIndentPattern': '^[ \\t]*(?:(?:end|fi|esac|od|fed|then|elif|else|in|ouse|out|do|postlude)(?![A-Za-z0-9_])|[)\\]])'
    'foldEndPattern': '^[ \\t]*(?:(?:end|fi|esac|od|fed)(?![A-Za-z0-9_])|[)\\]])'
