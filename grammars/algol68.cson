# ALGOL 68: the grammar of `*.a68` files.  It decides for every file which way its bold words are
# written, and hands the file to one of two rule sets:
#
#   source.algol68.upper    bold words in capitals (UPPER stropping: the Revised Report's examples
#                           in a hardware representation, Algol 68 Genie, PA/68): BEGIN, INT, Node
#   source.algol68.supper   reserved words in small letters (GNU Algol 68's default, SUPPER
#                           stropping): begin, int; indications begin with a capital letter
#
# The decision.  A grammar of regular expressions sees one line at a time and cannot tell whether a
# word in the middle of a line stands in a comment or a string; prose in a comment is full of
# words like "to", "in", "if".  So only a reserved word that begins a line decides:
#
#   * the first line that begins with a reserved word in capitals makes the rest of the file
#     capitals;
#   * the first line that begins the way only a small-letter source does, and has no reserved
#     word in capitals, makes the rest small letters: `begin`; `if`, `for`, `while`, `case` before
#     a word; a declaration (`int n := 3`, `ref Node p`, `long int k`, `proc f = `, `proc (`,
#     `mode Node`, `op MAX`, `prio MAX`, `struct (`, `module Shapes`, `access Units`), also after
#     an opening parenthesis (`(int n = 3; ...`); `goto label`; `pr include`; GNU's pragmat `[[`.
#     A small-letter word that is merely followed by another word does not: in a capitals source
#     `real width` and `int lengths` are identifiers of the standard prelude;
#   * until then, and in a file where neither happens, lines are read as capitals: that is right
#     for every such source, and in a small-letter source it leaves the reserved words of those
#     lines uncoloured.
#
# A decision holds to the end of the file: a file is written in one stropping.  The rule set in
# force is in the scope of every token (meta.stropping.upper.algol68, meta.stropping.supper.algol68).
# Inside a Markdown document the decision ends with the fenced block (a line that begins with a
# fence), which no ALGOL 68 source has.  README.md, "Capitals or small letters", says where the
# decision goes wrong.
'scopeName': 'source.algol68'
'name': 'ALGOL 68'
'fileTypes': [
  'a68'
]
'maxTokensPerLine': 1000
'limitLineLength': false
'patterns': [
  {
    'begin': '^(?=[ \\t]*(?:BEGIN|END|IF|THEN|ELIF|ELSE|FI|CASE|IN|OUSE|OUT|ESAC|FOR|FROM|BY|TO|WHILE|DO|OD|PAR|GOTO|GO|EXIT|SKIP|NIL|EMPTY|TRUE|FALSE|MODE|PROC|OP|PRIO|REF|STRUCT|UNION|FLEX|LONG|SHORT|HEAP|LOC|INT|REAL|BOOL|CHAR|VOID|COMPL|BITS|BYTES|STRING|SEMA|FILE|CHANNEL|FORMAT|CO|COMMENT|PR|PRAGMAT|MODULE|DEF|FED|POSTLUDE|PUB|ACCESS|NEST|DPAR|ASYNC|FUT|PURE|OF|AT|IS|ISNT)(?![A-Za-z0-9_]))'
    'end': '(?=^[ \\t]*(?:`{3,}|~{3,}))'
    'contentName': 'meta.stropping.upper.algol68'
    'patterns': [
      {
        'include': 'source.algol68.upper'
      }
    ]
  }
  {
    'begin': '^(?=[ \\t]*(?:begin(?![A-Za-z0-9_])(?:[ \\t]+[A-Za-z0-9("\\[{#]|[ \\t]*$)|(?:if|for|while|case)(?![A-Za-z0-9_])[ \\t]+[A-Za-z0-9("\\[{#]|(?:int|real|bool|char|void|string|compl|bits|bytes|sema|long|short|word|ref|flex|heap|loc)(?![A-Za-z0-9_])[ \\t]+(?:(?:int|real|bool|char|void|string|compl|bits|bytes|sema|long|short|word|ref|flex|heap|loc)(?![A-Za-z0-9_])|[A-Z\\[]|[a-z][a-z0-9_]*[ \\t]*(?:=|:=|,|;|$))|proc(?![A-Za-z0-9_])(?:[ \\t]*\\(|[ \\t]+(?:[a-z][a-z0-9_]*[ \\t]*(?:=|:=)|(?:int|real|bool|char|void|string|compl|bits|bytes|sema|long|short|word|ref|flex|heap|loc)(?![A-Za-z0-9_])|[A-Z]))|mode(?![A-Za-z0-9_])[ \\t]+[A-Z]|(?:module|access)(?![A-Za-z0-9_])(?:[ \\t]+[A-Z]|[ \\t]*$)|(?:op|prio)(?![A-Za-z0-9_])[ \\t]*(?:[A-Z]|[-+*/%<>=&~^!?])|(?:struct|union)(?![A-Za-z0-9_])[ \\t]*\\(|goto(?![A-Za-z0-9_])[ \\t]+[a-z]|(?:pr|pragmat)(?![A-Za-z0-9_])[ \\t]+[A-Za-z"]|\\(+[ \\t]*(?:(?:long|short|word|ref|flex)[ \\t]+)*(?:int|real|bool|char|void|string|compl|bits|bytes|sema)[ \\t]+[a-z][a-z0-9_]*[ \\t]*(?:=|:=|,|;)|\\[\\[[ \\t]*[a-z]))(?!.*(?<![A-Za-z0-9_])(?:BEGIN|END|IF|THEN|ELIF|ELSE|FI|CASE|IN|OUSE|OUT|ESAC|FOR|FROM|BY|TO|WHILE|DO|OD|PAR|GOTO|GO|EXIT|SKIP|NIL|EMPTY|TRUE|FALSE|MODE|PROC|OP|PRIO|REF|STRUCT|UNION|FLEX|LONG|SHORT|HEAP|LOC|INT|REAL|BOOL|CHAR|VOID|COMPL|BITS|BYTES|STRING|SEMA|FILE|CHANNEL|FORMAT|CO|COMMENT|PR|PRAGMAT|MODULE|DEF|FED|POSTLUDE|PUB|ACCESS|NEST|DPAR|ASYNC|FUT|PURE|OF|AT|IS|ISNT)(?![A-Za-z0-9_]))'
    'end': '(?=^[ \\t]*(?:`{3,}|~{3,}))'
    'contentName': 'meta.stropping.supper.algol68'
    'patterns': [
      {
        'include': 'source.algol68.supper'
      }
    ]
  }
  {
    'include': 'source.algol68.upper'
  }
]
